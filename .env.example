# Copy this file to `.env.local` and fill in real values.
# Local-only well-known defaults are fine for the Supabase vars when running `supabase start`.

# ─── Supabase (public — browser & server) ───────────────────────────────────────
# After `supabase start`, the CLI prints these. The anon JWT shown below is the
# *deterministic* local-dev key shipped by Supabase; production has different values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ─── Supabase (server-only) ─────────────────────────────────────────────────────
# Never expose this to the browser. Comes from `supabase status` locally.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ─── Microsoft OAuth (server-only, consumed by supabase/config.toml) ────────────
# Required for the Azure provider to handshake. See §4.2 of the execution plan.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DEV_TENANT_ID=

# ─── Email driver selection ─────────────────────────────────────────────────────
# One of: mock | mailpit | graph-dev | graph-prod
# Phase 0 default: mock (no external dependency).
EMAIL_DRIVER=mock
