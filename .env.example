# Copy to `.env.local` (or run `make bootstrap`, which generates it from
# `.env.bootstrap`). Local dev runs against a Docker Postgres 16 + Mailpit
# (`make dev`); production values come from Key Vault via Terraform.

# ─── Database (Azure Postgres prod / local Docker Postgres dev) ───────────────
# The app connects as the NON-owner role `app_user` so RLS applies; migrations
# connect as the admin (DATABASE_URL_ADMIN). In prod DATABASE_URL is composed
# from the Key-Vault app_user password and uses sslmode=require.
DATABASE_URL=postgres://app_user:apppw@localhost:5433/outreach
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5433/outreach
# DATABASE_URL_TEST=postgres://app_user:apppw@localhost:5433/outreach  # Uncomment to run DB integration tests
APP_USER_PASSWORD=apppw
# Local Postgres has no TLS — honoured ONLY in non-production.
PGSSL=disable

# ─── Auth (Auth.js v5 + Microsoft Entra ID) ───────────────────────────────────
# AUTH_SECRET signs the session JWT that the RLS context trusts (prod: Key Vault,
# and the app refuses to boot in prod without it). AZURE_AD_* are the Entra app
# registration; the issuer is tenant-pinned in prod.
AUTH_SECRET=dev-insecure-local-secret
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ─── Email ────────────────────────────────────────────────────────────────────
# One of: mock | mailpit | graph-dev | graph-prod. Local default: Mailpit (UI :8025).
EMAIL_DRIVER=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

# ─── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000

# ─── Dev-only mock auth ───────────────────────────────────────────────────────
# Triple-gated: ignored unless NODE_ENV != production AND this is `true` AND
# APP_BASE_URL is a loopback host — so it cannot activate on a remote/prod deploy.
AUTH_MOCK_ENABLED=true

# ─── Optional (prod cron / dialler; secrets come from Key Vault in prod) ──────
# CRON_ORG_ID=                 # the single org the scheduled email cron serves
# CRON_SENDER_EMAIL=           # sender mailbox unless the org sets settings.senderEmail
# CRON_SECRET=                 # gates /api/email/run|scan
# ADMIN_EMAIL_ALLOWLIST=       # comma-separated admin emails for /admin
# UNSUBSCRIBE_SECRET=          # HMAC-signs one-click unsubscribe links
# TELNYX_API_KEY=              # AMD dialler
# TELNYX_CONNECTION_ID=
# TELNYX_PUBLIC_KEY=
