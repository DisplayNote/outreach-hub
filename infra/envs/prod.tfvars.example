env = "prod"

# Supabase
supabase_access_token = "sbp_xxx"
supabase_project_ref  = "xxx"
supabase_db_password  = "xxx"
supabase_region       = "eu-west-2"

# Vercel
vercel_token      = "xxx"
vercel_org_id     = "team_xxx"
vercel_project_id = "prj_xxx"

# App hosting (DNS records are created manually, outside Terraform)
app_subdomain = "outreach" # → outreach.displaynote.com (create the CNAME by hand)

# Microsoft OAuth (production tenant — requires admin consent ticket from §4.3)
ms_client_id     = "xxx"
ms_client_secret = "xxx"
