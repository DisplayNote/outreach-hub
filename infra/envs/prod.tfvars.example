env = "prod"

# Azure
azure_subscription_id = "00000000-0000-0000-0000-000000000000"
azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
azure_location        = "uksouth"

# Postgres Flexible Server admin (rotate via Key Vault in production)
pg_admin_login    = "pgadmin"
pg_admin_password = "xxx"

# App hosting (DNS records are created manually, outside Terraform)
app_subdomain = "outreach" # → outreach.displaynote.com (create the CNAME by hand)
# app_base_url defaults to https://<app_subdomain>.displaynote.com; override only
# if the public origin differs from the subdomain convention.
# app_base_url = "https://outreach.displaynote.com"

# Container image — CI overrides this with the freshly-built ACR digest per deploy.
container_image = "acroutreachprod.azurecr.io/outreach-hub:latest"

# Entra app registration (Auth.js sign-in + cron app-only Graph). The same app
# reg must have BOTH delegated AND application Mail.Send / Mail.Read, admin-consented.
azure_ad_client_id     = "00000000-0000-0000-0000-000000000000"
azure_ad_client_secret = "xxx"
azure_ad_tenant_id     = "00000000-0000-0000-0000-000000000000"

# Email / cron behaviour
admin_email_allowlist = "alice@displaynote.com,bob@displaynote.com"
cron_org_id           = "00000000-0000-0000-0000-000000000000"
cron_sender_email     = "outreach@displaynote.com"

# Telnyx (AMD dialler, Mode B). Leave blank to disable the live telephony path.
# telnyx_api_key       = "xxx"
# telnyx_connection_id = "xxx"
# telnyx_public_key    = "xxx"
# bridge_sip_username  = "xxx"

# NOTE: AUTH_SECRET, CRON_SECRET and UNSUBSCRIBE_SECRET are NOT set here — they
# are generated by Terraform (random_password) and stored in Key Vault.
