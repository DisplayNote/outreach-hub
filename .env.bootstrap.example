# Copy to `.env.bootstrap` and fill in real values from docs/OUTREACH_HUB_EXECUTION_PLAN.md §4.6.
# This file is safe to commit; `.env.bootstrap` is gitignored.
#
# Required values are intentionally left blank: the bootstrap scripts reject
# empty required values, so a copied-but-unedited template fails fast.

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — required by `make bootstrap` (writes .env.local)
#
# This is ALL you need to develop locally. The app runs against the local
# Supabase CLI stack (`supabase start`); no Supabase cloud project and no Vercel
# are involved. These Microsoft app-registration values are required because the
# local Supabase Auth has the Azure provider enabled (supabase/config.toml).
# ─────────────────────────────────────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DEV_TENANT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION DEPLOY — required by `make bootstrap-prod` (writes infra/envs/prod.tfvars)
#
# Only needed when you deploy the prod cloud infrastructure. Leave blank for
# local-only development. There is a SINGLE cloud Supabase project (production);
# dev is local. DNS is managed manually, so no DNS token is needed.
# (SUPABASE_ACCESS_TOKEN looks like `sbp_...`.)
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_REPO=DisplayNote/outreach-hub
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
TF_STATE_KEY=
