# Copy to `.env.bootstrap` and fill in real values from docs/OUTREACH_HUB_EXECUTION_PLAN.md §4.6.
# This file is safe to commit; `.env.bootstrap` is gitignored.
#
# Required secrets are intentionally left blank: the bootstrap scripts reject
# empty required values, so a copied-but-unedited template fails fast instead of
# generating invalid `.env.local` / Terraform variables.

# GitHub
GITHUB_REPO=DisplayNote/outreach-hub

# Supabase (SUPABASE_ACCESS_TOKEN looks like `sbp_...`)
SUPABASE_ACCESS_TOKEN=
SUPABASE_DEV_PROJECT_REF=
SUPABASE_PROD_PROJECT_REF=
SUPABASE_DEV_DB_PASSWORD=
SUPABASE_PROD_DB_PASSWORD=

# Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Cloudflare DNS
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Microsoft (sandbox dev tenant)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DEV_TENANT_ID=

# Terraform
TF_STATE_KEY=
