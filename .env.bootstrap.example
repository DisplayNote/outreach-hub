# Copy to `.env.bootstrap` and fill in real values.
# This file is safe to commit; `.env.bootstrap` is gitignored.
#
# Required values are intentionally left blank: the bootstrap scripts reject
# empty required values, so a copied-but-unedited template fails fast.

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — required by `make bootstrap` (writes .env.local)
#
# This is ALL you need to develop locally. The app runs against a Docker
# Postgres 16 + Mailpit (docker-compose.dev.yml); no cloud project is involved.
# These Microsoft app-registration values feed the Auth.js Entra provider
# (mapped to AZURE_AD_* in .env.local).
# ─────────────────────────────────────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DEV_TENANT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION DEPLOY — required by `make bootstrap-prod` (writes infra/envs/prod.tfvars)
#
# Only needed when you deploy the prod Azure infrastructure. Leave blank for
# local-only development. There is a SINGLE cloud environment (production); dev
# is local. DNS is managed manually, so no DNS token is needed.
#
# AUTH_SECRET / CRON_SECRET / UNSUBSCRIBE_SECRET and the app_user DB password are
# NOT set here — Terraform generates them (random_password) into Key Vault.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_REPO=DisplayNote/outreach-hub

# Azure subscription / tenant the stack is provisioned into.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=uksouth

# Postgres Flexible Server admin (server owner; migrations connect as this).
PG_ADMIN_LOGIN=
PG_ADMIN_PASSWORD=

# Entra app registration (Auth.js sign-in + cron app-only Graph). The same app
# reg needs BOTH delegated AND application Mail.Send/Mail.Read, admin-consented.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Email / cron behaviour.
CRON_ORG_ID=
CRON_SENDER_EMAIL=
ADMIN_EMAIL_ALLOWLIST=

# App hosting (the CNAME is created manually in DNS).
APP_SUBDOMAIN=outreach
